# Copy to .env and fill locally. Never commit .env.
NANASE_API_BASE=https://api.openai.com/v1
NANASE_API_KEY=
NANASE_MODEL=your-model-name
NANASE_REASONING_EFFORT=high
NANASE_SERVICE_TIER=auto
NANASE_TODAY_RAW_LIMIT=24000
NANASE_CALL_LIMIT=1500
NANASE_LIFE_ENABLED=1
# Optional observer / generator. Empty values keep images disabled.
NANASE_IMAGE_API_BASE=
NANASE_IMAGE_API_KEY=
NANASE_VISION_MODEL=
NANASE_IMAGE_MODEL=
NANASE_IMAGE_DAILY_LIMIT=3
